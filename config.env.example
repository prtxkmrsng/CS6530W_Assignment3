# CS6530W Assignment 3 - Environment Configuration
# Default roll number is CS25M568.
# If you want to change the roll number, edit ROLLNO below.
# Keep this file identical on both gateway VMs!

ROLLNO="CS25M568"                 # Official roll number, UPPERCASE
SITE_A_WAN_IP="192.0.2.1"         # Transit IP for Gateway A (VM 1)
SITE_B_WAN_IP="192.0.2.2"         # Transit IP for Gateway B (VM 2)
WAN_PREFIX="24"                   # Subnet mask prefix (/24)
SITE_A_NET="10.1.0.0/24"          # Protected LAN subnet for Site A
SITE_B_NET="10.2.0.0/24"          # Protected LAN subnet for Site B
SITE_A_GW_LAN="10.1.0.1"          # Gateway A LAN IP (vethA-gw)
SITE_B_GW_LAN="10.2.0.1"          # Gateway B LAN IP (vethB-gw)
SITE_A_HOST="10.1.0.10"           # Host A IP (inside hostA namespace)
SITE_B_HOST="10.2.0.10"           # Host B IP (inside hostB namespace)

# Transit network interface (Network Adapter 2 in VMware Workstation):
# Leave blank ("") to let 01_setup_gateway.sh auto-detect your secondary interface (e.g., ens34, ens38).
# Or specify interface manually if needed (e.g., WAN_IF="ens34").
WAN_IF=""
WAN_IF_ASSIGN=""
