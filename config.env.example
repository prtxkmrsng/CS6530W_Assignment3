# cp config.env.example config.env  (same file content on both gateway VMs)
ROLLNO="CS24M001"                 # official roll number, UPPERCASE
SITE_A_WAN_IP="192.0.2.1"
SITE_B_WAN_IP="192.0.2.2"
WAN_PREFIX="24"
SITE_A_NET="10.1.0.0/24"
SITE_B_NET="10.2.0.0/24"
SITE_A_GW_LAN="10.1.0.1"
SITE_B_GW_LAN="10.2.0.1"
SITE_A_HOST="10.1.0.10"
SITE_B_HOST="10.2.0.10"
WAN_IF=""                         # blank = auto-detect interface holding this gateway's WAN IP
WAN_IF_ASSIGN=""                  # if WAN IP not yet configured: interface to assign it to (non-persistent)
